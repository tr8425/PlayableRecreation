<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    '몰입 모드'(기본 OFF) 전용. 켜면 식민자가 가구까지 걸어간 뒤 창이 열린다.
    바닐라 여가 Job 은 그대로 두고, 이 Job 은 여가 시스템과 무관하게 동작한다.
  -->
  <JobDef>
    <defName>PR_GoToGame</defName>
    <driverClass>PlayableRecreation.JobDriver_GoToGame</driverClass>
    <reportString>heading over to play.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!--
    몰입 모드 2칸 전용. 상대가 판 앞으로 걸어가 판이 끝날 때까지 선다.
    창을 여는 것은 이 Job 이 아니다 - 둘 다 닿았을 때 TogetherMatch 가 열어 준다.
  -->
  <JobDef>
    <defName>PR_JoinGame</defName>
    <driverClass>PlayableRecreation.JobDriver_JoinGame</driverClass>
    <reportString>sitting down to play with TargetB.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
