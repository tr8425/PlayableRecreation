<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    가구 하나를 "직접 할 수 있는 것"으로 만드는 정의.
    프레임워크는 여기까지만 안다 - 진입, 창, 세션, 기록, 숙련도.
    규칙과 AI 와 그림은 전부 workerClass 안에 있다.
  -->

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Ur</defName>
    <label>game of Ur</label>
    <description>Play a match of Ur against an AI opponent.</description>
    <workerClass>RoyalGameOfUr.UrGameWorker</workerClass>
    <targetThing>GameOfUrBoard</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>RGU.Difficulty</difficultyKeyPrefix>

    <tutorialPages>6</tutorialPages>
    <tutorialKeyPrefix>RGU.Tut</tutorialKeyPrefix>

    <supportsUndo>true</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>RGU.Tally.Captures</li>
      <li>RGU.Tally.CapturesTaken</li>
      <li>RGU.Tally.Rosettes</li>
    </tallyKeys>

    <vanillaJob>Play_GameOfUr</vanillaJob>
    <playThought>PR_PlayedUr</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Intellectual</linkedSkill>

    <windowSize>(980, 720)</windowSize>
  </PlayableRecreation.MiniGameDef>

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Horseshoes</defName>
    <label>horseshoes</label>
    <description>Pitch horseshoes at the pin against an AI opponent.</description>
    <workerClass>Throwing.ThrowGameWorker</workerClass>
    <targetThing>HorseshoesPin</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>THR.Difficulty</difficultyKeyPrefix>

    <tutorialPages>3</tutorialPages>
    <tutorialKeyPrefix>THR.Tut.HS</tutorialKeyPrefix>

    <supportsUndo>false</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>THR.Tally.Ringers</li>
      <li>THR.Tally.PointsFor</li>
      <li>THR.Tally.PointsAgainst</li>
    </tallyKeys>

    <vanillaJob>Play_Horseshoes</vanillaJob>
    <playThought>PR_PlayedHorseshoes</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Shooting</linkedSkill>

    <windowSize>(860, 700)</windowSize>

    <modExtensions>
      <li Class="Throwing.ThrowRulesExtension">
        <throwsPerInning>2</throwsPerInning>
        <targetScore>21</targetScore>
        <perThrowScoring>false</perThrowScoring>
        <ringerRadius>0.16</ringerRadius>
        <scoreRadius>0.55</scoreRadius>
        <ringerPoints>3</ringerPoints>
        <nearPoints>1</nearPoints>
        <ringerKey>THR.Ringer.Shoe</ringerKey>
      </li>
    </modExtensions>
  </PlayableRecreation.MiniGameDef>

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Hoopstone</defName>
    <label>hoopstone</label>
    <description>Toss stones through the ring against an AI opponent.</description>
    <workerClass>Throwing.ThrowGameWorker</workerClass>
    <targetThing>HoopstoneRing</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>THR.Difficulty</difficultyKeyPrefix>

    <tutorialPages>3</tutorialPages>
    <tutorialKeyPrefix>THR.Tut.HP</tutorialKeyPrefix>

    <supportsUndo>false</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>THR.Tally.Throughs</li>
      <li>THR.Tally.PointsFor</li>
      <li>THR.Tally.PointsAgainst</li>
    </tallyKeys>

    <vanillaJob>Play_Hoopstone</vanillaJob>
    <playThought>PR_PlayedHoopstone</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Shooting</linkedSkill>

    <windowSize>(860, 700)</windowSize>

    <!-- 같은 워커, 다른 규칙. 던질 때마다 채점하고 점수도 판도 짧다. -->
    <modExtensions>
      <li Class="Throwing.ThrowRulesExtension">
        <throwsPerInning>3</throwsPerInning>
        <targetScore>15</targetScore>
        <perThrowScoring>true</perThrowScoring>
        <ringerRadius>0.20</ringerRadius>
        <scoreRadius>0.34</scoreRadius>
        <ringerPoints>2</ringerPoints>
        <nearPoints>1</nearPoints>
        <ringerKey>THR.Ringer.Through</ringerKey>
      </li>
    </modExtensions>
  </PlayableRecreation.MiniGameDef>

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Billiards</defName>
    <label>nine-ball</label>
    <description>Run the table against an AI opponent.</description>
    <workerClass>Billiards.BilliardsGameWorker</workerClass>
    <targetThing>BilliardsTable</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>BIL.Difficulty</difficultyKeyPrefix>

    <tutorialPages>3</tutorialPages>
    <tutorialKeyPrefix>BIL.Tut</tutorialKeyPrefix>

    <supportsUndo>false</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>BIL.Tally.PocketedFor</li>
      <li>BIL.Tally.PocketedAgainst</li>
      <li>BIL.Tally.Fouls</li>
    </tallyKeys>

    <vanillaJob>Play_Billiards</vanillaJob>
    <playThought>PR_PlayedBilliards</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Shooting</linkedSkill>

    <windowSize>(1000, 720)</windowSize>
  </PlayableRecreation.MiniGameDef>

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Chess</defName>
    <label>chess</label>
    <description>Play a game of chess against an AI opponent.</description>
    <workerClass>Chess.ChessGameWorker</workerClass>
    <targetThing>ChessTable</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>CHS.Difficulty</difficultyKeyPrefix>

    <tutorialPages>4</tutorialPages>
    <tutorialKeyPrefix>CHS.Tut</tutorialKeyPrefix>

    <supportsUndo>true</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>CHS.Tally.Captures</li>
      <li>CHS.Tally.CapturesTaken</li>
      <li>CHS.Tally.Checks</li>
    </tallyKeys>

    <vanillaJob>Play_Chess</vanillaJob>
    <playThought>PR_PlayedChess</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Intellectual</linkedSkill>

    <windowSize>(1000, 760)</windowSize>
  </PlayableRecreation.MiniGameDef>

  <PlayableRecreation.MiniGameDef>
    <defName>PR_Poker</defName>
    <label>poker</label>
    <description>Play heads-up Texas hold'em against an AI opponent.</description>
    <workerClass>Poker.PokerGameWorker</workerClass>
    <targetThing>PokerTable</targetThing>

    <difficultyCount>5</difficultyCount>
    <difficultyKeyPrefix>POK.Difficulty</difficultyKeyPrefix>

    <tutorialPages>4</tutorialPages>
    <tutorialKeyPrefix>POK.Tut</tutorialKeyPrefix>

    <supportsUndo>false</supportsUndo>
    <supportsSave>true</supportsSave>
    <showLog>true</showLog>

    <tallyKeys>
      <li>POK.Tally.HandsWon</li>
      <li>POK.Tally.Showdowns</li>
      <li>POK.Tally.PeakStack</li>
    </tallyKeys>

    <vanillaJob>Play_Poker</vanillaJob>
    <playThought>PR_PlayedPoker</playThought>
    <wonTale>PR_WonMatch</wonTale>
    <linkedSkill>Intellectual</linkedSkill>

    <windowSize>(1020, 780)</windowSize>
  </PlayableRecreation.MiniGameDef>

  <!--
    망원경은 승부가 아니다. hasMatch 를 끄면 이기고 지는 것도, 전적도, 무르기도,
    난이도 선택도 사라진다 - 프레임워크가 그냥 창만 열어 준다.
  -->
  <PlayableRecreation.MiniGameDef>
    <defName>PR_Stargazing</defName>
    <label>stargazing</label>
    <description>Look at the sky over this world and name what you find in it.</description>
    <workerClass>Stargazing.StargazingWorker</workerClass>
    <targetThing>Telescope</targetThing>

    <hasMatch>false</hasMatch>
    <difficultyCount>1</difficultyCount>

    <tutorialPages>5</tutorialPages>
    <tutorialKeyPrefix>STG.Tut</tutorialKeyPrefix>

    <supportsUndo>false</supportsUndo>
    <supportsSave>false</supportsSave>
    <showLog>false</showLog>

    <vanillaJob>UseTelescope</vanillaJob>
    <playThought>PR_Stargazed</playThought>
    <linkedSkill>Intellectual</linkedSkill>

    <windowSize>(1180, 800)</windowSize>
  </PlayableRecreation.MiniGameDef>

</Defs>
